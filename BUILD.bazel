load("@rules_apple//apple:ios.bzl", "ios_application")
load("@rules_apple//apple:resources.bzl", "apple_resource_bundle")
load("@rules_swift//swift:swift_library.bzl", "swift_library")

config_setting(
    name = "ios_device",
    constraint_values = ["@apple_support//constraints:device"],
)

swift_library(
    name = "AppSources",
    srcs = glob(["App/*.swift"]),
    module_name = "Contact",
    data = [":WebPSamples", ":FFmpegSamples"],
    deps = ["//submodules/WebPBinding", "//submodules/FFMpegBinding"],
)

genrule(
    name = "raw_webp_png_sample",
    srcs = ["App/Resources/WebP/rivers.png"],
    outs = ["WebPSamples/rivers.png.bin"],
    cmd = "cp \"$(location App/Resources/WebP/rivers.png)\" \"$@\"",
)

apple_resource_bundle(
    name = "WebPSamples",
    bundle_name = "WebPSamples",
    resources = ["App/Resources/WebP/boats.jpg", ":raw_webp_png_sample"],
)

apple_resource_bundle(
    name = "FFmpegSamples",
    bundle_name = "FFmpegSamples",
    resources = ["App/Resources/FFmpeg/demo.mp4"],
)

ios_application(
    name = "Contact",
    bundle_id = "org.airlance.Contact",
    families = ["iphone", "ipad"],
    infoplists = ["App/Info.plist"],
    minimum_os_version = "16.0",
    provisioning_profile = select({
        ":ios_device": "signing/development.mobileprovision",
        "//conditions:default": None,
    }),
    deps = [":AppSources"],
)
