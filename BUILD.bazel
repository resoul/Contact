load("@rules_apple//apple:ios.bzl", "ios_application")
load("@rules_apple//apple:resources.bzl", "apple_metal_library")
load("@rules_swift//swift:swift_library.bzl", "swift_library")
load("@rules_cc//cc:objc_library.bzl", "objc_library")
load("@rules_swift//swift:swift_interop_hint.bzl", "swift_interop_hint")

swift_interop_hint(name = "particle_interop", module_name = "ParticleTypes")

objc_library(
    name = "ParticleTypes",
    hdrs = ["App/MetalVFXEngine/Shaders/ParticleStructures.h"],
    enable_modules = True,
    module_name = "ParticleTypes",
    aspect_hints = [":particle_interop"],
)

config_setting(
    name = "ios_device",
    constraint_values = ["@apple_support//constraints:device"],
)

genrule(
    name = "DeviceEntitlements",
    srcs = ["signing/development.mobileprovision"],
    tools = ["tools/signing/device-entitlements.py"],
    outs = ["ContactDevice.entitlements"],
    cmd = "/usr/bin/python3 $(location tools/signing/device-entitlements.py) $(location signing/development.mobileprovision) $@",
)

apple_metal_library(
    name = "MessengerShaders",
    srcs = glob(["App/MetalVFXEngine/Shaders/*.metal"]),
    hdrs = glob(["App/MetalVFXEngine/Shaders/*.h"]),
    out = "default.metallib",
    visibility = ["//visibility:public"],
)

swift_library(
    name = "AppSources",
    srcs = glob(["App/**/*.swift"]),
    module_name = "Contact",
    data = [
        ":MessengerShaders",
        "App/Messenger/MascotLogin/login_mascot.riv",
        "//libraries/rive:RiveRuntime-LICENSE.txt",
    ] + glob(["App/Messenger/Avatars/Resources/*"]),
    deps = [
        ":ParticleTypes",
        "//libraries/rive",
        "//submodules/ContactStorage",
        "//submodules/AsyncDisplayKit",
        "//submodules/ListUI",
        "//submodules/AvatarUI",
    ],
)

ios_application(
    name = "Contact",
    bundle_id = "org.airlance.Contact",
    families = ["iphone", "ipad"],
    infoplists = ["App/Info.plist"],
    minimum_os_version = "16.0",
    entitlements = select({
        ":ios_device": ":DeviceEntitlements",
        "//conditions:default": "App/Simulator.entitlements",
    }),
    provisioning_profile = select({
        ":ios_device": "signing/development.mobileprovision",
        "//conditions:default": None,
    }),
    deps = [":AppSources"],
    visibility = ["//visibility:public"],
)
